<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F8FF">
<LinearLayout android:id="@+id/infoRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F8FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        android:minHeight="56dp">

        <ImageButton
            android:id="@+id/btnVolverInfo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_nav_back"
            android:contentDescription="Volver a la pantalla anterior"
            android:padding="14dp"
            app:tint="#2E7D32" />

        <TextView
            android:id="@+id/tituloInformacion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Guía del aguinaldo"
            android:textSize="21sp"
            android:textColor="#1B5E20"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAbrirNavegacion"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_menu_hamburguesa"
            android:contentDescription="Abrir menú de navegación"
            android:tooltipText="Menú"
            android:padding="12dp"
            app:tint="#2E7D32" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollInformacion"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false">
        <LinearLayout
            android:id="@+id/contenidoInformacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="4dp"
            android:paddingBottom="24dp" />
    </ScrollView>
</LinearLayout>
<com.google.android.material.navigation.NavigationView
    android:id="@+id/navigationView"
    android:layout_width="300dp"
    android:layout_height="match_parent"
    android:layout_gravity="start"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF"
    app:headerLayout="@layout/navigation_header"
    app:itemIconTint="#2E7D32"
    app:itemTextColor="#244631"
    app:menu="@menu/navigation_menu" />
</androidx.drawerlayout.widget.DrawerLayout>
