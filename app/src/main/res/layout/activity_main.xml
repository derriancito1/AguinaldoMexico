<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F8FF"
    tools:context=".MainActivity">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/adView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/linearContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Título -->
            <TextView
                android:id="@+id/textTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculadora de Aguinaldo México"
                android:textSize="24sp"
                android:textColor="#2E7D32"
                android:textStyle="bold"
                android:layout_gravity="center"
                android:paddingBottom="24dp" />

            <!-- Fecha de ingreso -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de ingreso"
                android:textSize="16sp"
                android:textColor="#1B5E20"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etFechaIngreso"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:focusable="false"
                android:clickable="true"
                android:hint="Selecciona la fecha"
                android:inputType="none"
                android:background="@drawable/edittext_background"
                android:padding="12dp" />

            <!-- Fecha de salida -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fecha de salida"
                android:textSize="16sp"
                android:textColor="#1B5E20"
                android:paddingTop="12dp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/etFechaSalida"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:focusable="false"
                android:clickable="true"
                android:hint="Selecciona la fecha"
                android:inputType="none"
                android:background="@drawable/edittext_background"
                android:padding="12dp" />

            <!-- Salario mensual con botón ayuda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Salario mensual (MXN)"
                    android:textSize="16sp"
                    android:textColor="#1B5E20" />

                <ImageButton
                    android:id="@+id/btnAyudaSalario"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ayuda salario mensual"
                    android:src="@android:drawable/ic_menu_help"
                    ads:tint="#1B5E20"
                    android:padding="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etSalarioMensual"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="numberDecimal"
                android:hint="Ej. 8480"
                android:background="@drawable/edittext_background"
                android:padding="12dp" />

            <!-- Días de aguinaldo con botón ayuda -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="16dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Días de aguinaldo"
                    android:textSize="16sp"
                    android:textColor="#1B5E20" />

                <ImageButton
                    android:id="@+id/btnAyudaDiasAguinaldo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Ayuda días de aguinaldo"
                    android:src="@android:drawable/ic_menu_help"
                    ads:tint="#1B5E20"
                    android:padding="4dp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDiasAguinaldo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:inputType="number"
                android:hint="Por defecto 15"
                android:background="@drawable/edittext_background"
                android:padding="12dp" />

            <!-- Botón calcular -->
            <Button
                android:id="@+id/btnCalcular"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Calcular Aguinaldo"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:backgroundTint="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginTop="24dp" />

            <!-- Resultados -->
            <TextView
                android:id="@+id/tvResultadoTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Resultados"
                android:textSize="20sp"
                android:textColor="#1B5E20"
                android:textStyle="bold"
                android:paddingTop="24dp" />

            <TextView
                android:id="@+id/tvResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="16sp"
                android:textColor="#000000"
                android:paddingTop="16dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Banner AdMob fijo abajo -->
    <com.google.android.gms.ads.AdView
        android:id="@+id/adView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        ads:adSize="BANNER"
        ads:adUnitId="@string/banner_ad_unit_id"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
